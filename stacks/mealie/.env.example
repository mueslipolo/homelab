# Internal LAN domain — mealie is reached at mealie.<this value> via Caddy
INTERNAL_DOMAIN=home.example.com

# Not a credential, just PII — real value goes in your untracked .env
DEFAULT_EMAIL=admin@example.com

# NAS volume paths for this stack's persistent state — own top-level Shared
# Folder (/path/to/mealie), not under /path/to/docker, so backup-critical app
# data sits on its own share.
MEALIE_PGDATA_PATH=/path/to/mealie/pgdata
MEALIE_DATA_PATH=/path/to/mealie/data

# Secrets — do not put real values in this file (it's the tracked example).
# Set real values directly in Portainer's per-stack Environment Variables UI.
# Never committed to git in any form.
POSTGRES_PASSWORD=

# Authelia OIDC client secret (the Random Password, not the Digest) — see
# stacks/authelia/README.md's secret-generation command. Same value's hash
# goes in Authelia's own config as mealie_client_secret_hash.
MEALIE_OIDC_CLIENT_SECRET=
