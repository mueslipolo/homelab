# Time zone for logs and schedules: a tz database name. Default: Europe/Zurich.
TZ=Europe/Berlin

# NAS paths. Two roots on purpose (README):
# IMMICH_UPLOAD_LOCATION: the photos and videos, Immich's database dumps
# (backups/) and what it can make again. Its own shared folder, so Hyper
# Backup and Snapshot Replication can take it.
IMMICH_UPLOAD_LOCATION=/path/to/immich
# IMMICH_DOCKER_ROOT: the live Postgres database (postgres/). Not backed up as
# files: Immich's own dumps in IMMICH_UPLOAD_LOCATION/backups restore it.
IMMICH_DOCKER_ROOT=/path/to/docker/immich

# Optional. HDD (default) or SSD: the disk IMMICH_DOCKER_ROOT is on.
# DB_STORAGE_TYPE=HDD

# Optional. Machine-learning requests served at once (default 2, about half
# of a 4-core CPU; README, "CPU").
# MACHINE_LEARNING_REQUEST_THREADS=2

# Secrets: do not put real values in this file (it's the tracked example).
# Set them in the stack's environment variables in Dockhand (secrets marked secret). Never committed.
# Database password, letters and digits only (Immich's rule):
#   openssl rand -hex 32
DB_PASSWORD=

# The OIDC client secret is NOT a variable here: Immich keeps its OAuth
# settings in its database, set in Administration > Settings > Authentication
# Settings > OAuth (guide 12, step 5). Its digest goes into Authelia's
# secrets as immich_client_secret_hash.
