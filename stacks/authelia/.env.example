# Internal LAN domain — Authelia's login portal is auth.<this value>, and its
# session cookie is scoped to this whole domain so it's shared across every
# app subdomain.
INTERNAL_DOMAIN=home.example.com

# The `proxy` Docker network's own gateway IP — how this container reaches
# host-level services (the NAS's own LDAP Server package). Find via
# `docker network inspect proxy --format '{{json .IPAM.Config}}'`. See
# stacks/edge/README.md's "Host services … via PROXY_GATEWAY_IP" gotcha.
PROXY_GATEWAY_IP=192.0.2.1

# LDAP directory's Base DN, from Synology LDAP Server's own setup (its FQDN
# field determines this — see docs/guides/05-sso-authelia.md, "Before you start").
LDAP_BASE_DN=dc=example,dc=lan

# NAS paths — real state (db.sqlite3: consent, regulation and OIDC state;
# notification.txt, users_database.yml; login sessions are in memory), never
# tracked in git.
AUTHELIA_DATA_ROOT=/path/to/docker/authelia/data

# NAS path holding the secret files (README.md lists them all) — generated directly on the
# NAS via SSH, never committed to git in any form, not even encrypted. See
# docs/guides/05-sso-authelia.md, step 1, for the exact generation commands. Authelia's own documentation
# strongly recommends file-based secrets over plain environment variables
# (exposed via `docker inspect`, process listings, etc.) — this stack follows
# that recommendation instead of this repo's usual Portainer-Environment-
# Variables-only pattern, a deliberate one-off exception (see README.md).
#   AUTHELIA_SECRETS_ROOT/session_secret
#   AUTHELIA_SECRETS_ROOT/storage_encryption_key
#   AUTHELIA_SECRETS_ROOT/jwt_secret
#   AUTHELIA_SECRETS_ROOT/oidc_hmac_secret
#   AUTHELIA_SECRETS_ROOT/oidc_jwks_private_key.pem
#   AUTHELIA_SECRETS_ROOT/paperless_client_secret_hash
#   AUTHELIA_SECRETS_ROOT/portainer_client_secret_hash
#   AUTHELIA_SECRETS_ROOT/forgejo_client_secret_hash
#   AUTHELIA_SECRETS_ROOT/mealie_client_secret_hash
#   AUTHELIA_SECRETS_ROOT/ldap_bind_password
AUTHELIA_SECRETS_ROOT=/path/to/docker/authelia/secrets
