# Internal LAN domain — each service is reached at <name>.<this value> via Caddy
INTERNAL_DOMAIN=example.lan

# Synology UID / GID these services run as. Find them on the NAS with
# `id <user>` and `getent group <name>` — real values go in Portainer's
# per-stack Environment Variables, never in this tracked file.
PUID=<uid>
PGID=<gid>

# NAS volume paths
MEDIARR_CONFIG_ROOT=/path/to/docker/mediarr-config
MEDIA_ROOT=/path/to/media
