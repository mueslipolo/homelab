# Dockhand is started by hand, not deployed by itself (docs/guides/02-dockhand.md):
# copy this file to dockhand.env outside the clone, next to jobs.env, and pass it
# with --env-file. No secrets here: Dockhand keeps its users, git credential and
# each stack's variables in its own database, in the data folder.

# Dockhand's data: database, encryption key, git clones, each stack's files.
# The same path inside the container (compose.yaml says why).
DOCKHAND_DATA_ROOT=/volume1/docker/dockhand-data

TZ=Europe/Zurich

# Where port 3010 is published. Default 127.0.0.1: the NAS's loopback, for the
# scheduler only. 0.0.0.0 for a fresh install's first setup, until Caddy serves
# dockhand.<internal-domain> (guide 02, steps 2 and 7); then remove this line.
# DOCKHAND_HOST_IP=0.0.0.0
