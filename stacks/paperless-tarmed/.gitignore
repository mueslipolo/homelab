# Re-include the package data. The repo root ignores `**/data/` (unanchored,
# any depth) for NAS state directories, which would otherwise swallow
# paperless_tarmed/data/: catalogue.json, without which every extraction fails
# (FileNotFoundError), and tariff_types.json, refresh-tariffs' baseline.
#
# This MUST be a directory-level negation. `!paperless_tarmed/data/<file>` looks
# equivalent and does nothing: git cannot re-include a file whose parent
# directory is excluded.
!paperless_tarmed/data/

# The compose bind mount, anchored to this stack directory only — deliberately
# NOT the package data dir negated above.
/data/
.cache/

# Real justificatifs carry patient names, addresses, birth dates and insurance
# numbers. The sample-based tests skip when absent. Do not remove: this repo is
# meant to be publishable, and PHI in git history is not revocable.
samples/

# `report --csv` writes patient names and amounts. Same reasoning as samples/.
*.csv

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
dist/
build/
.env

# `uv run` (README Tests, CI) writes one; the image installs from pyproject.toml.
uv.lock
