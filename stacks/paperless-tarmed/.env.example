# Copy to .env and fill in. Never commit the real file.

# --- Paperless connection (required for everything except `extract`) ---------
PAPERLESS_URL=https://paperless.home.example.com
PAPERLESS_TOKEN=
# Set to 0 if Paperless is served with a self-signed certificate.
PAPERLESS_TARMED_VERIFY_SSL=1

# --- Field mapping: which extracted value goes to which custom field ---------
# Run `paperless-tarmed fields` to list the values and your instance's fields.
# Field names are whatever YOU called them, in any language. Map any subset;
# unmapped values are simply never written.
#
#   patient           Patient given name
#   treatment_date    Oldest treatment date on the justificatif
#   total             Payable total ('Montant de la facture' / 'A payer')
#   total_unrounded   Total before Swiss 5-cent rounding ('Montant total')
#   category          Short category from the line items' tariff type
#   provider          Short provider label
#   provider_gln      Provider's 13-digit GLN/EAN
#
# EDIT THIS: the right-hand names must match YOUR fields exactly (see `fields`).
PAPERLESS_TARMED_FIELDS=patient=CHANGE_ME,treatment_date=CHANGE_ME,total=CHANGE_ME
# Use JSON instead when a field name contains a comma:
# PAPERLESS_TARMED_FIELDS={"patient": "Betrifft, wen", "total": "Betrag"}

# --- Patients ------------------------------------------------------------------
# Optional allow-list. When set, a name not on it is refused rather than guessed.
# When unset, whatever given name the document carries is used as-is.
# Matching already ignores case, accents and extra given names.
# PAPERLESS_TARMED_PATIENTS=Anna,Bruno,Carla,David
# Nicknames / different spellings -> a name on the list above.
# PAPERLESS_TARMED_ALIASES=Annie=Anna

# --- Title ---------------------------------------------------------------------
# Placeholders: any value key above, plus {date} as an alias for {treatment_date}.
# Segments that cannot be filled are dropped. Leave empty to never touch titles.
PAPERLESS_TARMED_TITLE={patient} - {category} - {treatment_date} - {provider}

# --- Behaviour -----------------------------------------------------------------
# Default filters for `pull`. Optional; --document-type / --since override them.
PAPERLESS_TARMED_DOCUMENT_TYPE=Justificatif de remboursement
# Relative span (2y, 18m, 90d, 6w) or an ISO date. Empty means no age limit.
PAPERLESS_TARMED_SINCE=2y
# Tag applied when a value was skipped or substituted on a justificatif. A
# document with no justificatif page (a letter, an invoice) is left untagged,
# unless Paperless typed it as PAPERLESS_TARMED_DOCUMENT_TYPE: then the missing
# page is the failure. Empty disables tagging.
PAPERLESS_TARMED_REVIEW_TAG=extraction-failed
# Tag applied once a justificatif was read with nothing to review. A
# justificatif without it was never processed (e.g. the webhook did not fire).
# Each tagging also leaves a dated note: what was written, or why it failed.
# Empty disables this tag.
PAPERLESS_TARMED_DONE_TAG=tarmed

# Pin a short provider label to a 13-digit GLN when the automatic rule picks
# something you dislike. The GLN is stable; the printed name is not.
# PAPERLESS_TARMED_GLN_OVERRIDES=7600000000004=HRN

# Category comes from the official code catalogues (README, "Category"); no
# configuration. Relabel the tariff-type fallback if you want other words:
# PAPERLESS_TARMED_CATEGORIES=317=Labor,001=Arzt

# --- Plausibility bounds; a value outside these is never written --------------
PAPERLESS_TARMED_MAX_AMOUNT=50000
PAPERLESS_TARMED_MAX_AGE_DAYS=3650
PAPERLESS_TARMED_FUTURE_TOLERANCE_DAYS=2
PAPERLESS_TARMED_MAX_SPAN_DAYS=730

# --- Webhook ------------------------------------------------------------------
# Shared secret; Paperless must send it as the X-Paperless-Tarmed-Secret header.
PAPERLESS_TARMED_WEBHOOK_SECRET=

# The webhook fills blank custom fields and leaves titles alone, matching
# `apply`'s defaults. Set either to 1 only deliberately: both make a run able to
# modify a document it has already processed, so a "Document Updated" trigger
# would re-trigger this service indefinitely. Retitling also renames files on
# disk when PAPERLESS_FILENAME_FORMAT includes the title.
# PAPERLESS_TARMED_WEBHOOK_OVERWRITE=0
# PAPERLESS_TARMED_WEBHOOK_TITLE=0

# --- Tariff table -------------------------------------------------------------
# Where `refresh-tariffs` writes, and where the table is read from if it exists.
# The Docker image sets this to /data/tariff_types.json.
# PAPERLESS_TARMED_TARIFF_PATH=/data/tariff_types.json

# --- Deployment (compose.yaml only; the CLI ignores these) ---------------------
# Absolute NAS path for the pull cache, tariff table and change journal. A
# relative path resolves inside Portainer's stack directory.
PAPERLESS_TARMED_DATA=/path/to/paperless-tarmed/data
# External Docker network Paperless's `webserver` is on. Default: proxy.
# PAPERLESS_NETWORK=proxy
# Local image to run; it must already exist on the NAS (pull_policy: never).
# Default: paperless-tarmed:0.1.0, the tag the build-images job builds -- change
# both together, here and in scripts/jobs.conf.
# PAPERLESS_TARMED_IMAGE=paperless-tarmed:0.1.0
# Container timezone. Default: Europe/Zurich.
# TZ=Europe/Zurich
