# Internal LAN domain — paperless is reached at paperless.<this value> via Caddy
INTERNAL_DOMAIN=home.example.com

# NAS volume paths — two deliberate roots, not a bug (see README)
PAPERLESS_DOCKER_ROOT=/path/to/docker/paperless
PAPERLESS_DATA_ROOT=/path/to/paperless
PAPERLESS_INBOX_PATH=/path/to/paperless-inbox

# UID/GID the webserver and broker run as (USERMAP_UID/GID for paperless-ngx)
PAPERLESS_UID=<uid>
PAPERLESS_GID=<gid>

# Secrets — do not put real values in this file (it's the tracked example).
# Set real values directly in Portainer's per-stack Environment Variables when
# creating this Stack. Never committed to git.
POSTGRES_PASSWORD=
PAPERLESS_SECRET_KEY=

# OIDC client secret for native Authelia login — the
# PLAINTEXT value here (not a hash; contrast with Authelia's own side, which
# stores a one-way hash of this same value). Generate via:
#   docker run --rm "authelia/authelia:$AUTHELIA_VERSION" authelia crypto hash generate pbkdf2 --random --random.length 64 --random.charset alphanumeric
# Use the "Random Password" output here; the "Digest" output goes into
# stacks/authelia's own secrets instead. See stacks/authelia/README.md.
PAPERLESS_OIDC_CLIENT_SECRET=
