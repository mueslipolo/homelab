	import tls_wildcard
	import authelia
	reverse_proxy maintainerr:6246
}

# Authelia's own login portal — Phase 5. Deliberately not gated by Authelia
# itself (see authelia's own access_control bypass rule for this hostname);
# a login portal that requires being logged in to reach is unreachable.
auth.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	reverse_proxy authelia:9091
}

# Host-level services, not containers on the proxy network — reached via the
# proxy network's OWN gateway IP, not host.docker.internal and not the NAS's
# real LAN IP. See the "Reaching host-level services" gotcha in this stack's
# README before changing this — the obvious-looking alternatives both fail
# for non-obvious reasons.
portainer.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	# Portainer's 9443 is HTTPS-only (self-signed) — its plain-HTTP port (9000)
	# was never published to the host, so this is the only reachable port.
	# tls_insecure_skip_verify is deliberate: this hop never leaves the NAS
	# (Caddy -> proxy network's gateway -> Portainer, all on one host), so
	# there's no network to eavesdrop on between them.
	# No "https://" prefix on the address below — do not add one back. Caddy
	# rejects a placeholder inside an upstream address when that address also
	# has a scheme ("placeholders are not allowed when an upstream address
	# contains a scheme"), which crash-loops the whole container, not just
	# this route. The transport block alone is sufficient to make this an
	# HTTPS connection; the scheme prefix is only ever a shorthand, never
	# required.
	reverse_proxy {env.PROXY_GATEWAY_IP}:9443 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

forgejo.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	reverse_proxy {env.PROXY_GATEWAY_IP}:3000
}

# Catch-all for any other subdomain — avoids silently exposing a default page
# for hostnames that were never deliberately registered above.
*.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	respond "Not found — no app registered at this hostname." 404
}
