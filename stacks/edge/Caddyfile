{
	email {env.ACME_EMAIL}
}

(tls_wildcard) {
	tls {
		dns infomaniak {env.INFOMANIAK_API_TOKEN}
	}
}

# Forward-auth gate, proven via a PoC on dashboard alone (Phase 5 Step 2a)
# before being rolled out to the other full-gate apps below (Step 3).
# Deliberately NOT imported into: jellyfin (confirmed bypass, Chromecast
# can't complete a browser SSO redirect), mealie (needs the hybrid bypass
# pattern instead, its mobile app hits /api directly — Step 2b, not done
# yet), auth itself (a login portal gated behind login is unreachable).
(authelia) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
}

dashboard.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	import authelia
	reverse_proxy dashboard:8080
}

mealie.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	# No forward_auth — switched to native OIDC (mealie's own OIDC_AUTO_REDIRECT),
	# same reasoning as paperless/portainer/forgejo below. Was full-gate; Mealie
	# has no trusted-header auto-login support, so the old setup double-logged
	# (Authelia, then Mealie's own form) instead of true SSO.
	reverse_proxy mealie:9000
}

paperless.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	reverse_proxy webserver:8000
}

