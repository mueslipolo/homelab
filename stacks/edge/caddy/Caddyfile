{
	email {env.ACME_EMAIL}
}

(tls_wildcard) {
	tls {
		dns infomaniak {env.INFOMANIAK_API_TOKEN}
	}
}

# Forward-auth gate. Deliberately NOT imported into: jellyfin (Chromecast
# can't complete a browser SSO redirect), mealie and paperless (native OIDC),
# auth itself (a login portal gated behind login is unreachable).
# For the *arrs: their "Disabled for Local Addresses" only skips their own
# login for a request with no X-Forwarded-For. With the header, even a LAN
# address gets the login form (tested on Prowlarr 2.6). Without it they see
# Caddy's Docker address, which counts as local; Authelia's gate still decides
# who gets through. Caddy never forwards a client-supplied X-Forwarded-For, so
# this cannot be used to look local from outside.
(arr_no_client_ip) {
	header_up -X-Forwarded-For
}

# Caddy's own error pages (502 app not answering, 504 too slow, 404 unknown
# host, 500 Caddy's error): errors/error.html, rendered with the status, host,
# upstream and error ID. Imported by every site. The log keeps only requests
# that end in a 5xx, with the error ID and reason, so the ID on a page can be
# found with: docker logs <caddy> 2>&1 | grep <id>
(errors) {
	log {
		level ERROR
	}
	handle_errors {
		log_append err_id {err.id}
		log_append err_msg {err.message}
		root * /etc/caddy/errors
		rewrite * /error.html
		templates
		file_server {
			status {err.status_code}
		}
	}
}

(authelia) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
}

dashboard.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	import errors
	import authelia
	# Shows each error page on demand (behind Authelia), to check them.
	error /__error/404 404
	error /__error/500 500
	error /__error/502 502
	error /__error/504 504
	reverse_proxy dashboard:8080
}

mealie.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	import errors
	# No forward_auth: native OIDC (mealie's own OIDC_AUTO_REDIRECT). Was
	# full-gate; forward_auth plus Mealie's own login meant two logins.
	reverse_proxy mealie:9000
}

