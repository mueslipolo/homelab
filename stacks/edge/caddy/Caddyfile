# No Authelia gate: the ntfy apps and the *arrs talk to its API directly. ntfy
# has its own users and tokens, with anonymous access denied.
ntfy.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	import errors
	reverse_proxy ntfy:8080
}

maintainerr.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	import errors
	import authelia
	reverse_proxy maintainerr:6246
}

# Authelia's own login portal. Deliberately not gated by Authelia
# itself (see authelia's own access_control bypass rule for this hostname);
# a login portal that requires being logged in to reach is unreachable.
auth.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	import errors
	reverse_proxy authelia:9091
}

# Dockhand (stacks/dockhand), which deploys the stacks: a container on
# `proxy`, reached by name. No `import authelia`: its login is OIDC through
# Authelia (client `dockhand`, admins_only), and the gate on top would mean two
# logins. Before this route goes live, Dockhand's own authentication must be on
# (off on a fresh install: docs/guides/02-dockhand.md).
dockhand.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	import errors
	reverse_proxy dockhand:3000
}

# Forgejo through its published port 3000, like a host-level service — reached
# via the proxy network's OWN gateway IP, not host.docker.internal and not the
# NAS's real LAN IP. See the "Host services … via PROXY_GATEWAY_IP" gotcha in
# this stack's README before changing this: the alternatives did not answer
# (cause not established).
forgejo.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	import errors
	reverse_proxy {env.PROXY_GATEWAY_IP}:3000
}

# Catch-all for any other subdomain — avoids silently exposing a default page
# for hostnames that were never deliberately registered above. Shows the 404
# error page.
*.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	import errors
	error 404
}
