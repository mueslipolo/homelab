{
	email {env.ACME_EMAIL}
}

(tls_wildcard) {
	tls {
		# The provider from DNS_PROVIDER, its token from DNS_API_TOKEN. A
		# provider that wants more than one token: its own syntax here
		# (docs/guides/03-https-letsencrypt.md, "Another DNS provider").
		dns {$DNS_PROVIDER} {env.DNS_API_TOKEN}
	}
}

# Forward-auth gate. Deliberately NOT imported into: jellyfin (Chromecast
# can't complete a browser SSO redirect), mealie, paperless and immich (native
# OIDC; Immich's phone app also calls its API directly),
# auth itself (a login portal gated behind login is unreachable).
# For the *arrs: their "Disabled for Local Addresses" only skips their own
# login for a request with no X-Forwarded-For. With the header, even a LAN
# address gets the login form (tested on Prowlarr 2.6). Without it they see
# Caddy's Docker address, which counts as local; Authelia's gate still decides
# who gets through. Caddy never forwards a client-supplied X-Forwarded-For, so
# this cannot be used to look local from outside.
(arr_no_client_ip) {
	header_up -X-Forwarded-For
}

# Caddy's own error pages (502 app not answering, 504 too slow, 404 unknown
# host, 500 Caddy's error): errors/error.html, rendered with the status, host,
# upstream and error ID. Imported by every site. The log keeps only requests
# that end in a 5xx, with the error ID and reason, so the ID on a page can be
# found with: docker logs <caddy> 2>&1 | grep <id>
(errors) {
	log {
		level ERROR
	}
	handle_errors {
		log_append err_id {err.id}
		log_append err_msg {err.message}
		root * /etc/caddy/errors
		rewrite * /error.html
		templates
		file_server {
			status {err.status_code}
		}
	}
}

(authelia) {
	forward_auth authelia:9091 {
		uri /api/authz/forward-auth
		copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
	}
}

dashboard.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	import errors
	import authelia
	# Someone logged in but not in the admin group gets the family's page,
	# whatever the path (forward_auth runs first and replaces any Remote-*
	# header the client sent). Authelia's rules refuse them the rest too.
	@family {
		header Remote-User *
		not header_regexp Remote-Groups (^|,){$ADMIN_GROUP:infra-admins}(,|$)
	}
	handle @family {
		@page not path /icons/* /fonts/* /gopher/*
		rewrite @page /welcome.html
		reverse_proxy dashboard:8080
	}
	handle {
		# Shows each error page on demand (behind Authelia), to check them.
		error /__error/404 404
		error /__error/500 500
		error /__error/502 502
		error /__error/504 504
		reverse_proxy dashboard:8080
	}
}

mealie.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	import errors
	# No forward_auth: native OIDC (mealie's own OIDC_AUTO_REDIRECT). Was
	# full-gate; forward_auth plus Mealie's own login meant two logins.
	# Not logged in yet (no session cookie): straight to Authelia, instead of
	# Mealie's login page loading for seconds before it redirects itself.
	# Anything with a query (Authelia's ?code= callback, ?direct=1 after a
	# logout or failed login, ?redirect= from a share) goes to Mealie as is.
	# Cookie name from Mealie's mealie/routes/auth/auth.py (v3.29): if a
	# release renames it, this only stops skipping the page.
	@mealie_login {
		path / /login
		expression `{http.request.uri.query} == ""`
		not header Cookie *mealie.access_token=*
	}
	redir @mealie_login /api/auth/oauth
	reverse_proxy mealie:9000
}

paperless.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	import errors
	reverse_proxy webserver:8000
}

# No forward_auth: Immich logs in by OIDC itself, and its phone app calls the
# API with its own token, which a gate would refuse. Caddy's defaults suit
# large video uploads: no body size limit, no limit on a whole upload's time
# (only a stall of 1 minute aborts it).
immich.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	import errors
	reverse_proxy immich-server:2283
}

sonarr.{$INTERNAL_DOMAIN} {
	import tls_wildcard
	import errors
	import authelia
	reverse_proxy sonarr:8989 {
		import arr_no_client_ip
	}
}

