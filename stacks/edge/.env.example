# A real domain (or subdomain) whose DNS provider has a Caddy module
# (https://github.com/caddy-dns). Apps get
# <app>.<this value>; Caddy gets one wildcard cert for *.<this value>.
# Resolved to Caddy by the LAN's DNS only; no public record is needed.
INTERNAL_DOMAIN=home.example.com

# Which Caddyfile in caddy/ to load. Caddyfile.minimal = one test app,
# no Authelia (docs/guides/03-https-letsencrypt.md).
CADDYFILE=Caddyfile

# Contact email for ACME/Let's Encrypt account registration (expiry notices etc.)
# Not a secret, but real PII — placeholder here, real value set in Dockhand.
ACME_EMAIL=admin@example.com

# The DNS provider: the module's name at https://github.com/caddy-dns (built
# into Caddy), e.g. infomaniak, cloudflare, hetzner, desec. Default: infomaniak.
DNS_PROVIDER=cloudflare

# Secret — do not put a real value in this file (it's the tracked example).
# Set the real value directly in Dockhand's per-stack variables (secret).
# Highest-severity secret in this whole repo: controls the domain. The
# module's README says which token and permissions it needs.
DNS_API_TOKEN=

# Caddy gets its own dedicated LAN IP via a macvlan network — see
# docs/architecture.md ("Network and certificates") for why. Not secrets, but
# real network layout — placeholders here, real values set in Dockhand, same
# as everything else in this repo.
LAN_SUBNET=192.0.2.0/24
LAN_GATEWAY=192.0.2.1
LAN_PARENT_INTERFACE=eth0
CADDY_LAN_IP=192.0.2.20
CADDY_LAN_MAC=02:42:ac:11:00:20

# The `proxy` Docker network's own gateway IP — NOT the NAS's real LAN IP,
# NOT host.docker.internal. Required for Caddy to reach Forgejo (via its
# published port 3000). See README.md's gotchas
# before assuming a simpler-looking value works here. Find the real value with:
#   docker network inspect proxy --format '{{json .IPAM.Config}}'
PROXY_GATEWAY_IP=192.0.2.1

# Optional: the admin group, if not infra-admins. Same value as the authelia
# stack's ADMIN_GROUP: outside it, the dashboard shows only its family page.
# ADMIN_GROUP=infra-admins
