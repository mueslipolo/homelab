# ntfy notifications from a MikroTik router (RouterOS 7): a new device on the
# LAN, internet down/back, WireGuard peers connecting. Pushes to the homelab
# topic through Caddy. Setup: docs/guides/11-notifications.md, "MikroTik".
#
# Before importing, replace in this file:
#   ntfy.home.example.com   your ntfy hostname (resolvable by the router)
#   tk_REPLACE_ME           the ntfy publish token
# Then upload it (Files, or scp) and: /import ntfy.rsc
# Re-importing replaces everything below; nothing else is touched.
#
# The router checks ntfy's certificate (check-certificate=yes): import Let's
# Encrypt's roots once, see the guide. Generated by ntfy-rsc.py: edit that.

/system script remove [find where name~"^ntfy-"]
/system scheduler remove [find where name~"^ntfy-"]
/tool netwatch remove [find where comment~"^ntfy-"]

# ---- ntfy-send: the one place with the URL and token
/system script add name=ntfy-send policy=read,write,policy,test dont-require-permissions=no source="# Push one message to ntfy. Call it as a function:\r\
    \n#   :local send [:parse [/system script get ntfy-send source]]\r\
    \n#   \$send title=\"...\" message=\"...\" tags=\"...\" priority=\"...\"\r\
    \n:local url \"https://ntfy.home.example.com/homelab\"\r\
    \n:local token \"tk_REPLACE_ME\"\r\
    \n# /tool fetch separates header fields with commas: none in the title.\r\
    \n:local t \"\"\r\
    \n:if ([:len \$title] > 0) do={\r\
    \n  :for i from=0 to=([:len \$title] - 1) do={\r\
    \n    :local c [:pick \$title \$i]\r\
    \n    :if (\$c = \",\") do={ :set c \";\" }\r\
    \n    :set t (\$t . \$c)\r\
    \n  }\r\
    \n}\r\
    \n:local hdr (\"Authorization: Bearer \" . \$token . \",Title: \" . \$t)\r\
    \n:if ([:len \$tags] > 0) do={ :set hdr (\$hdr . \",Tags: \" . \$tags) }\r\
    \n:if ([:len \$priority] > 0) do={ :set hdr (\$hdr . \",Priority: \" . \$priority) }\r\
    \n:do {\r\
    \n  /tool fetch url=\$url http-method=post http-header-field=\$hdr http-data=\$message output=none check-certificate=yes\r\
    \n} on-error={ :log warning (\"ntfy: could not send: \" . \$t) }"

# ---- ntfy-dhcp: called by the DHCP server's lease-script
/system script add name=ntfy-dhcp policy=read,write,policy,test dont-require-permissions=no source="# A device got a lease that is not a static lease: push it once per MAC\r\
    \n# until the next reboot, and name leases after their host name. Called by the\r\
    \n# DHCP server's lease-script with\r\
    \n# bound= mac= ip= host= and optionally where= (see the end of ntfy.rsc):\r\
    \n# \"LAN\" by default, \"Wi-Fi\" on an access point with its own DHCP.\r\
    \n:global ntfySeenMacs\r\
    \n:local w \"LAN\"\r\
    \n:if ([:len \$where] > 0) do={ :set w \$where }\r\
    \n:if ([:typeof \$ntfySeenMacs] != \"array\") do={ :set ntfySeenMacs [:toarray \"\"] }\r\
    \n:if ([:tostr \$bound] = \"1\") do={\r\
    \n  # Static leases are the known devices.\r\
    \n  :local known false\r\
    \n  :foreach l in=[/ip dhcp-server lease find where mac-address=\$mac] do={\r\
    \n    :if (![/ip dhcp-server lease get \$l dynamic]) do={ :set known true }\r\
    \n  }\r\
    \n  :if (!\$known) do={\r\
    \n    :if ([:typeof (\$ntfySeenMacs->\$mac)] = \"nothing\") do={\r\
    \n      :set (\$ntfySeenMacs->\$mac) true\r\
    \n      :local name \$host\r\
    \n      # Android sends its host name only in a later DHCP message: the lease\r\
    \n      # record has it a moment after this script starts. Then its vendor class\r\
    \n      # (e.g. android-dhcp-14) says at least what it is.\r\
    \n      :if ([:len \$name] = 0) do={\r\
    \n        :delay 5s\r\
    \n        :foreach l in=[/ip dhcp-server lease find where mac-address=\$mac] do={\r\
    \n          :local h [/ip dhcp-server lease get \$l host-name]\r\
    \n          :if ([:len \$h] > 0) do={ :set name \$h }\r\
    \n          :if ([:len \$name] = 0) do={\r\
    \n            :do { :set name [/ip dhcp-server lease get \$l class-id] } on-error={}\r\
    \n          }\r\
    \n        }\r\
    \n      }\r\
    \n      :if ([:len \$name] = 0) do={ :set name \"(no host name)\" }\r\
    \n      :local send [:parse [/system script get ntfy-send source]]\r\
    \n      # Visitors come and go: no \"make it static\" advice for a guest network.\r\
    \n      :local tip \"\\nKnown device\? Make its lease static and it won't alert again.\"\r\
    \n      :if (\$w ~ \"guest\") do={ :set tip \"\" }\r\
    \n      \$send title=(\"New device on the \" . \$w . \": \" . \$name) message=(\$name . \"\\nMAC \" . \$mac . \"\\nIP \" . \$ip . \$tip) tags=\"eyes\" priority=\"high\"\r\
    \n    }\r\
    \n  }\r\
    \n  # Every device, known or new: a lease without a comment gets its host name\r\
    \n  # as one, so the lease list says what each device is. A comment you wrote\r\
    \n  # yourself is never touched.\r\
    \n  # A lease that never had a comment has none, not an empty one, and\r\
    \n  # `find where comment=\"\"` does not match it: check each lease instead.\r\
    \n  :local unnamed false\r\
    \n  :foreach l in=[/ip dhcp-server lease find where mac-address=\$mac] do={\r\
    \n    :if ([:len [/ip dhcp-server lease get \$l comment]] = 0) do={ :set unnamed true }\r\
    \n  }\r\
    \n  :if (\$unnamed) do={\r\
    \n    :delay 6s\r\
    \n    :foreach l in=[/ip dhcp-server lease find where mac-address=\$mac] do={\r\
    \n      :local h [/ip dhcp-server lease get \$l host-name]\r\
    \n      :if ([:len [/ip dhcp-server lease get \$l comment]] = 0 && [:len \$h] > 0) do={\r\
    \n        :do { /ip dhcp-server lease set \$l comment=\$h } on-error={}\r\
    \n      }\r\
    \n    }\r\
    \n  }\r\
    \n}"

# ---- ntfy-inet: called by netwatch
/system script add name=ntfy-inet policy=read,write,policy,test dont-require-permissions=no source="# Netwatch up/down for the hosts commented ntfy-inet-*. \"Internet down\" only\r\
    \n# when every one of them is down; \"back up\" with how long it lasted.\r\
    \n# Called with host= state=up|down. While the internet is down, ntfy on the\r\
    \n# LAN still delivers to Android phones on the Wi-Fi; iPhones need ntfy.sh.\r\
    \n:global ntfyInetDownAt\r\
    \n:local send [:parse [/system script get ntfy-send source]]\r\
    \n:if (\$state = \"down\") do={\r\
    \n  :local allDown true\r\
    \n  :foreach n in=[/tool netwatch find where comment~\"^ntfy-inet\"] do={\r\
    \n    :if ([/tool netwatch get \$n status] != \"down\") do={ :set allDown false }\r\
    \n  }\r\
    \n  :if (\$allDown && [:typeof \$ntfyInetDownAt] != \"time\") do={\r\
    \n    :set ntfyInetDownAt [:timestamp]\r\
    \n    \$send title=\"Internet down\" message=\"No answer from any of the netwatch hosts.\" tags=\"rotating_light\" priority=\"high\"\r\
    \n  }\r\
    \n}\r\
    \n:if (\$state = \"up\" && [:typeof \$ntfyInetDownAt] = \"time\") do={\r\
    \n  :local lasted ([:timestamp] - \$ntfyInetDownAt)\r\
    \n  :set ntfyInetDownAt \"\"\r\
    \n  \$send title=\"Internet back\" message=(\"Down for \" . [:tostr \$lasted]) tags=\"white_check_mark\"\r\
    \n}"

# ---- ntfy-wg: run by the scheduler
/system script add name=ntfy-wg policy=read,write,policy,test dont-require-permissions=no source="# Every minute: a WireGuard peer whose last handshake is under 3 min old is\r\
    \n# connected; one with none for 10 min after that has gone quiet. Pushes the\r\
    \n# transitions only. Named by comment, else name, else start of its key.\r\
    \n:global ntfyWgUp\r\
    \n:if ([:typeof \$ntfyWgUp] != \"array\") do={ :set ntfyWgUp [:toarray \"\"] }\r\
    \n:local send [:parse [/system script get ntfy-send source]]\r\
    \n:foreach p in=[/interface wireguard peers find] do={\r\
    \n  :local key [:tostr \$p]\r\
    \n  :local name [/interface wireguard peers get \$p comment]\r\
    \n  :if ([:len \$name] = 0) do={ :do { :set name [/interface wireguard peers get \$p name] } on-error={} }\r\
    \n  :if ([:len \$name] = 0) do={ :set name [:pick [/interface wireguard peers get \$p public-key] 0 8] }\r\
    \n  :local hs [/interface wireguard peers get \$p last-handshake]\r\
    \n  :local recent false\r\
    \n  :local gone true\r\
    \n  :if ([:typeof \$hs] = \"time\") do={\r\
    \n    :if (\$hs < 3m) do={ :set recent true }\r\
    \n    :if (\$hs < 10m) do={ :set gone false }\r\
    \n  }\r\
    \n  :local was false\r\
    \n  :if ([:typeof (\$ntfyWgUp->\$key)] = \"bool\") do={ :set was (\$ntfyWgUp->\$key) }\r\
    \n  :if (\$recent && !\$was) do={\r\
    \n    :set (\$ntfyWgUp->\$key) true\r\
    \n    \$send title=(\"VPN: \" . \$name . \" connected\") message=(\"WireGuard peer \" . \$name . \" is connected.\") tags=\"key\" priority=\"low\"\r\
    \n  }\r\
    \n  :if (\$gone && \$was) do={\r\
    \n    :set (\$ntfyWgUp->\$key) false\r\
    \n    \$send title=(\"VPN: \" . \$name . \" gone quiet\") message=(\"No handshake from \" . \$name . \" for 10 minutes.\") tags=\"zzz\" priority=\"low\"\r\
    \n  }\r\
    \n}"

# ---- internet: two public resolvers, so one of them failing is not an outage
/tool netwatch add host=1.1.1.1 type=icmp interval=30s comment=ntfy-inet-1 \
    up-script=":local f [:parse [/system script get ntfy-inet source]]; \$f host=1.1.1.1 state=up" \
    down-script=":local f [:parse [/system script get ntfy-inet source]]; \$f host=1.1.1.1 state=down"
/tool netwatch add host=9.9.9.9 type=icmp interval=30s comment=ntfy-inet-2 \
    up-script=":local f [:parse [/system script get ntfy-inet source]]; \$f host=9.9.9.9 state=up" \
    down-script=":local f [:parse [/system script get ntfy-inet source]]; \$f host=9.9.9.9 state=down"

# ---- WireGuard: checked every minute
/system scheduler add name=ntfy-wg interval=1m start-time=startup policy=read,write,policy,test \
    on-event="/system script run ntfy-wg"

# ---- new devices: attach the lease script to your LAN DHCP server(s). Not done
# here, because it replaces any lease-script already set. Run, with your
# server's name (/ip dhcp-server print):
#
# /ip dhcp-server set [find name=defconf] lease-script=":local f [:parse [/system script get ntfy-dhcp source]]; \$f bound=\$leaseBound mac=\$leaseActMAC ip=\$leaseActIP host=\$\"lease-hostname\""
#
# On a Wi-Fi access point with its own DHCP, add where="Wi-Fi" at the end of
# that lease-script, so its alerts say "New device on the Wi-Fi".
#
# The lease-script also names each lease after its host name (as a comment)
# from the next time the device connects. To name the existing ones at once:
#
# /ip dhcp-server lease { :foreach l in=[find where host-name!=""] do={ :if ([:len [get $l comment]] = 0) do={ set $l comment=[get $l host-name] } } }
